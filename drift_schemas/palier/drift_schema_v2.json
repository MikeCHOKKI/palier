  "fixed_sql": [
    {
      "name": "profiles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"profiles\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"name\" TEXT NOT NULL, \"accent\" TEXT NOT NULL, \"currency\" TEXT NOT NULL DEFAULT 'XOF', \"is_minor\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_minor\" IN (0, 1)), \"expenses_enabled\" INTEGER NOT NULL DEFAULT 1 CHECK (\"expenses_enabled\" IN (0, 1)), \"sport_enabled\" INTEGER NOT NULL DEFAULT 1 CHECK (\"sport_enabled\" IN (0, 1)), \"pin_hash\" TEXT NULL, \"pin_salt\" TEXT NULL, \"pin_iterations\" INTEGER NULL, \"biometric_enabled\" INTEGER NOT NULL DEFAULT 0 CHECK (\"biometric_enabled\" IN (0, 1)), \"failed_pin_attempts\" INTEGER NOT NULL DEFAULT 0, \"locked_until\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "accounts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"accounts\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"profile_id\" TEXT NOT NULL REFERENCES profiles (id), \"name\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"opening_balance\" INTEGER NOT NULL DEFAULT 0, \"position\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"profile_id\" TEXT NOT NULL REFERENCES profiles (id), \"name\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"icon\" TEXT NOT NULL, \"position\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "operations",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"operations\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"profile_id\" TEXT NOT NULL REFERENCES profiles (id), \"kind\" TEXT NOT NULL, \"amount\" INTEGER NOT NULL CHECK(\"amount\" > 0), \"account_id\" TEXT NOT NULL REFERENCES accounts (id), \"to_account_id\" TEXT NULL REFERENCES accounts (id), \"category_id\" TEXT NULL REFERENCES categories (id), \"note\" TEXT NULL, \"occurred_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "operations_profile_date",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX operations_profile_date ON operations (profile_id, occurred_at)"
        }
      ]
    }
  ]
