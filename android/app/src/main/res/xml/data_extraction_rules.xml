<?xml version="1.0" encoding="utf-8"?>
<!-- Aucune copie automatique des données (finances, santé) vers le cloud ou un
     autre appareil : la sauvegarde passe par l'export chiffré de l'application. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
